
<%- include("header.ejs") %>
  <div class="heroes">
    <div class="overlay">
        <h1>Dj with the magic fingers.</h1>
    </div>
  </div>
 

  <div class="services">

    <h1>Creat Posts</h1>
    <div class="serv_parent">
      
    <form action="/get/show" method="post" enctype="multipart/form-data">

      <input type="hidden" name="_csrf" value="<%=csrfToken%>">
      
      <div>
        <label for="name">Service Name:</label>
        <input type="text" id="serv_name" name="name" required>
      </div>
     
  <div>
    <label for="description">Description:</label>
    <textarea row="5" id="serv_description" name="description" required></textarea>
  </div>
      
  <div>
    <label for="image">Service_image:</label>
    <input type="file" id="serv_image" name="serviceImage" accept="image/*" required>
  </div>
     <div>
      <label for="price">Service Price :</label>
      <input type="number" id="serv_price" name="price" required step="0.01" min="0">
     </div>
      <button type="submit">Add Service</button>
    </form>
    </div>
    </div>
     
    
    <%- include("links.ejs")%>   

</div>

<%- include("footer.ejs") %>

</body>
</html>
