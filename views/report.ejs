<%- include("header.ejs") %>
<div>
  <h3 >Hello <%=userName%>, Your Clients Booking Report.</h3>
</div>
    <a href="/auth/logout"><button>Logout</button></a>

    <div id="user_pagee">
      
    <% if (record.length > 0){%> 
        <table> 
          <thead>
         <tr>
        
          <th>User</th>
          <th>Service</th>
          <th>Amount</th>
          <th>Status</th>
          <th>Tel</th>
          <th>Event_Date</th>
          <th>City</th>
          <th>Addr</th>
          <th>Starts</th>
          <th>Ends_At</th>
          <th>Music</th>
          
          
         </tr>
       </thead>
       <tbody>
        <tr>
            <% record.forEach(entry =>{ %>
             <td><%= entry.user_name %></td>
             <td><%= entry.name %></td>
             <td><%= entry.price %></td>
             <td><%= entry.status%></td>
             <td><%= entry.appointment_mobile%></td>
             <td><%= entry.appointment_date.toLocaleString()%></td>
             <td><%= entry.appointment_city%></td>
             <td><%= entry.appointment_address%></td>
             <td><%= entry.start_time%></td>
             <td><%= entry.end_time%></td>
             <td><%= entry.music_desc%></td>
          
           </tr>
        <%})  %>
    </tbody>
  </table>
      <% }else{ %>
        <p>You have no Appointments.</p>
         
     <% } %> 
      </div>
<div>
      <%- include("links.ejs")%>  

    </div>
<%- include("footer.ejs") %>