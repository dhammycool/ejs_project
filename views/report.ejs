<%- include("header.ejs") %>
<div>
  <h3 >Hello <%=userName%>, Your Clients Booking Report.</h3>
  <div>
    <a href="/logout"><button>Logout</button></a>
    <div id="user_pagee">
    <% if (record.length > 0){%> 
        <table> 
          <thead>
         <tr>
        
          <th>User</th>
          <th>Service</th>
          <th>Amount</th>
          <th>Status</th>
          <th>Tel</th>
          <th>Event_Date</th>
          <th>City</th>
          <th>Addr</th>
          <th>Starts</th>
          <th>Ends_At</th>
          <th>Music</th>
          
          
         </tr>
       </thead>
       <tbody>
        <tr>
            <% record.forEach(entry =>{ %>
             <td><%= entry.user_name %></td>
             <td><%= entry.name %></td>
             <td><%= entry.price %></td>
             <td><%= entry.status%></td>
             <td><%= entry.appointment_mobile%></td>
             <td><%= entry.appointment_date.toLocaleString()%></td>
             <td><%= entry.appointment_city%></td>
             <td><%= entry.appointment_address%></td>
             <td><%= entry.start_time%></td>
             <td><%= entry.end_time%></td>
             <td><%= entry.music_desc%></td>
          
           </tr>
        <%})  %>
    </tbody>
  </table>
      <% }else{ %>
        <p>You have no Appointments.</p>
         
     <% } %> 
      </div>
</div>

<div class="services">

  <h1>Creat Posts</h1>
  <div class="serv_parent">
  <form action="/add-service" method="post" enctype="multipart/form-data">
    <div>
      <label for="name">Service Name:</label>
      <input type="text" id="serv_name" name="name" required>
    </div>
   
<div>
  <label for="description">Description:</label>
  <textarea row="5" id="serv_description" name="description" required></textarea>
</div>
    
<div>
  <label for="image">Service_image:</label>
  <input type="file" id="serv_image" name="serviceImage" accept="image/*" required>
</div>
   <div>
    <label for="price">Service Price :</label>
    <input type="number" id="serv_price" name="price" required step="0.01" min="0">
   </div>
    <button type="submit">Add Service</button>
  </form>
  </div>
  </div>

<%if(locals.service){%>
<div class="services">
  <h1>Put/Patch/Delete Post</h1>
  
  <div class="serv_parent">
  <form action="" method="post" enctype="multipart/form-data">
    <div>
      <label for="name">Service Name:</label>
      <input type="text" id="serv_name" name="<%=service.name%>" required>
    </div>
   
<div>
  <label for="description">Description:</label>
  <textarea row="5" id="serv_description" name="<%=service.description%>" required></textarea>
</div>
    
<div>
  <label for="image">Service_image:</label>
  <input type="file" id="serv_image" name="serviceImage" accept="image/*" required>
</div>

   <div>
    <label for="price">Service Price :</label>
    <input type="number" id="serv_price" name="price" required step="0.01" min="0">
   </div>

    <button type="submit">Delete</button>
  </form>
<%  }%>
  </div>
  </div>

<%- include("footer.ejs") %>