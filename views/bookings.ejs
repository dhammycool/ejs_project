<%- include("header.ejs") %>
<div class="heroes">
  <div class="overlay">
      <h1>Dj with the magic fingers...</h1>
  </div>
</div>


<div class="form_parent">
    <h1>Book Your Event.</h1>
    <p>Kindly use the form below to book any kind of event with us today.</p>

    <div class="form_container">

      <form action="/get/bookings" method="post">
        <input type="hidden" name="_csrf" value="<%=csrfToken%>">
        <div class="contact">
         <input type="hidden" name="service_id" value="<%= service.id %>">
         <input type="hidden" name="user_id" value="<%= user.id %>">
          <label for="phone">Enter a phone number:</label>
          <input type="tel"  name="phone"   required>
          <label>Address</label>
          <textarea rows="4" cols="80" name="address" required></textarea>
        
      
      
          <label for="city">Enter a City for Event:</label>
          <input list="cities" name="cities">
          <datalist id="cities">
            <option value="Lagos">
            <option value="Abuja">
            <option value="Ibadan">
            <option value="Awka">
            <option value="Kano">
              <option value="Port Harcourt">
                <option value="Nneyi-Umuleri">
                <option value="Onitsha">
                <option value="Maiduguri">
                <option value="Aba">
                  <option value="Benin City">
                    <option value="Shagamu">
                    <option value="Ikare">
                    <option value="Ogbomoso">
                    <option value="Mushin">
                      <option value="Owerri">
                        <option value="Ikeja">
                        <option value="Agege">
                        <option value="Somolu">
                        <option value="Sokoto">
                          <option value="Nnewi">
                            <option value="Ilesa">
                            <option value="Minna">
                            <option value="Apapa">
                            <option value="Bida">
                              <option value="Ilobu">
                                <option value="Ajegunle">
                                <option value="Oshodi">
                                <option value="Ifako">
                                <option value="Surulere">
                                  <option value="Ebute-Metta">
                                    <option value="Ojota">
                                    <option value="Ikotun">
                                    <option value="Makera">
                                    <option value="Umundugba">
                                      <option value="Ojo">
                                        <option value="Okrika">
                                        <option value="Uselu">
                                        <option value="Kpor">
                                        <option value="Neni">
                                          <option value="Ozubulu">
                                            <option value="Festac Town">
                                            <option value="Buguma">
                                            <option value="Hadejia">
                                            <option value="Amaigbo">
                                              <option value="Ungogo">
                                                <option value="Ikoyi">
                                                <option value="Effurun">
                                                <option value="Dikenafai">
                                                <option value="Kumbotso">
                                                  <option value="Nnenasa">
                                                    <option value="Ojoto">
                                                    <option value="Rumuodomaya">
                                                    <option value="Itu">
                                                    <option value="Afor-Oru">
                                                      <option value="Isinweke">
                                                        <option value="Ogu">
                                                        <option value="Nchia">
                                                        <option value="Egbeda">
                                                        <option value="Ukpo">
                                                          <option value="Abagana">
                                                            <option value="Suleja">
                                                           
          </datalist>
      
          <label for="Event Picker">Choose Date and Time:</label>
          <input type="datetime-local"  name="date" required/>
      
          <label for="start_time">Event Start Time</label>
         <input type="time"  name="start_time"/>
      
          <label for="finish_time">Event End Time</label>
          <input type="time"  name="finish_time"/>
          <label>Kindly describe the type of Music to be played at your event</label>
          <textarea rows="4" cols="80" name="music_desc" required></textarea>
          <button type="submit">Book Appointment</button>
        </div>
      </form>
      </div>
      </div>

  
<%- include("footer.ejs") %>
</body>
</html>