<%- include("header.ejs") %>

<div>
    <h2> Hello <%= userName %>, Thanks for your Patronage.</h2>
</div>


    <h4>My Appointment</h4>

    <div id="user_pagee">
        <% if (record.length > 0) { %> 
            <table> 
                <thead>
                    <tr> 
                        <th>Appointmnet ID</th>
                        <th>Name</th>
                        <th>Price</th>
                        <th>Date</th>
                        <th>Event Starts</th>
                        <th>Ends</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% record.forEach(entry => { %>
                        <tr>
                            <td><%= entry.id %></td>
                            <td><%= entry.name %></td>
                            <td><%= entry.price %></td>
                            <td><%= entry.appointment_date.toLocaleString() %></td>
                            <td><%= entry.start_time %></td>
                            <td><%= entry.end_time %></td>
                            <td><%= entry.status %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } else { %>
            <p>Hello <%= userName %>, You have no Appointments.</p>
        <% } %> 
    </div>

    <h2>Payment History</h2>
    <div id="history">
        <% if (payments.length > 0) { %>
            <table> 
                <thead>
                    <tr>
                        <th>Appointment ID</th> 
                        <th>Payment ID</th>
                        <th>Amount</th>
                        <th>Payment Method</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% payments.forEach(pay => { %>
                        <tr>
                            <td><%= pay.appointment_id %></td>
                            <td><%= pay.payment_id %></td>
                            <td>NGN <%= parseFloat(pay.amount).toLocaleString() %></td>
                            <td><%= pay.payment_method %></td>
                            <td><%= pay.payment_status %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } else { %>
            <p>No payments found.</p>
        <% } %>
    </div>

    <a href="/logout"><button>Logout</button></a>


<%- include("footer.ejs") %>
</body>
</html>
